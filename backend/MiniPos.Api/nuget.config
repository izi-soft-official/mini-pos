<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Use a container-local global packages folder -->
    <add key="globalPackagesFolder" value="/root/.nuget/packages" />
  </config>
  <fallbackPackageFolders>
    <!-- empty to avoid host-specific fallback package folders being referenced -->
  </fallbackPackageFolders>
</configuration>
